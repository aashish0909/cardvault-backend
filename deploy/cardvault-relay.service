# CardVault relay - hardened systemd unit.
# Install: cp cardvault-relay.service /etc/systemd/system/ && systemctl enable --now cardvault-relay
# After npm ci --omit=dev, tsx is not installed. Use Node 22 type stripping.
# Do NOT set MemoryDenyWriteExecute=true (breaks V8 JIT) or SystemCallFilter=@system-service (often breaks Node).
# Generate VAPID keys ON THE SERVER and put them only in this unit (chmod 600). Never copy vapid.json.

[Unit]
Description=CardVault zero-knowledge relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/cardvault/server
ExecStart=/usr/bin/node --experimental-strip-types /opt/cardvault/server/src/index.ts

# --- relay configuration -----------------------------------------------------
# Loopback only: the relay must be reachable solely through the Caddy proxy.
Environment=HOST=127.0.0.1
Environment=PORT=8787
# We are behind Caddy: trust its X-Forwarded-For for rate limiting.
Environment=TRUST_PROXY=1
# Comma-separated browser origins allowed to call the relay cross-origin.
Environment=CORS_ORIGINS=https://vault.betterstatement.com
# VAPID keys (generate once on the server: npm exec web-push generate-vapid-keys).
# Never copy server/vapid.json to the server.
Environment=VAPID_PUBLIC_KEY=REPLACE_ME
Environment=VAPID_PRIVATE_KEY=REPLACE_ME
# Contact URI embedded in VAPID JWTs. Apple rejects .local mailtos with 403.
Environment=VAPID_SUBJECT=https://vault.betterstatement.com
# Leave DEBUG_TOKEN unset in production (disables GET /v1/debug entirely).

# Writable state: device registrations + web-push subscriptions (ProtectSystem=strict
# otherwise blocks writes). systemd sets STATE_DIRECTORY automatically.
StateDirectory=cardvault-relay

# --- hardening ----------------------------------------------------------------
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
