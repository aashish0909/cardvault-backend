# CardVault single-server Caddyfile.
# The web PWA is served from the same origin as the relay, so the browser app
# needs no CORS and no VITE_RELAY_URL - its /v1/* calls hit Caddy directly.

vault.betterstatement.com {
	encode gzip zstd

	# Relay API (TLS-terminated here; relay itself listens on 127.0.0.1:8787).
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /health {
		reverse_proxy 127.0.0.1:8787
	}

	# Static PWA build (cardvault-web/dist).
	handle {
		root * /var/www/cardvault
		try_files {path} /index.html
		file_server

		# Service worker must always be revalidated; hashed assets are immutable.
		header /sw.js Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		# Security headers (mirrors cardvault-web/netlify.toml).
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(self), microphone=(), geolocation=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /v1/csp-report"
			-remove X-Powered-By
		}
	}
}
