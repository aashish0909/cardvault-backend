{
  "expo": {
    "name": "CardVault",
    "slug": "cardvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardvault",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardvault.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cardvault.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow CardVault to protect your cards with Face ID."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CardVault to unlock your vault with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CardVault to scan QR codes to pair with friends.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F8CFF",
          "defaultChannel": "requests"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac13d83c-63b8-4885-9719-1afe76f0d7e0"
      }
    },
    "owner": "aashish999"
  }
}
